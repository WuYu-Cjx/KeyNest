<Window x:Class="KeyNest.Installer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Installer.WindowTitle}"
        Width="828"
        Height="636"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="{DynamicResource Font.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Border Margin="14"
            CornerRadius="{DynamicResource Radius.Window}"
            Background="{DynamicResource Brush.Window}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Effect="{StaticResource Shadow.Dialog}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0"
                  Height="72"
                  Margin="24,0,12,0"
                  Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="38" Height="38" CornerRadius="12" Background="{DynamicResource Brush.BrandSoft}">
                    <Viewbox Margin="8">
                        <Canvas Width="32" Height="32">
                            <Path Data="M6,22 C6,14.6 10.5,9.6 16,9.6 C21.5,9.6 26,14.6 26,22"
                                  Stroke="{DynamicResource Brush.Brand}"
                                  StrokeThickness="2.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="13.2" Canvas.Top="17" Width="5.6" Height="5.6" Fill="{DynamicResource Brush.Brand}" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource App.ProductFullName}" FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{DynamicResource App.Tagline}" FontSize="11.5"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StepText"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               FontSize="12"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                    <Button Width="34" Height="30" Style="{StaticResource Btn.Ghost}" Padding="0"
                            Click="OnCloseClick" ToolTip="{DynamicResource Common.Close}">
                        <Path Data="M0,0 L10,10 M10,0 L0,10"
                              Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Brush.TextSecondary}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Margin="28,0,28,0" Padding="0,4,0,0">
                <ContentControl x:Name="PageHost"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch" />
            </Border>

            <!-- 底部导航 -->
            <Border Grid.Row="2"
                    Padding="24,14"
                    BorderBrush="{DynamicResource Brush.Divider}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton"
                            Content="{DynamicResource Common.Cancel}"
                            Style="{StaticResource Btn.Ghost}"
                            HorizontalAlignment="Left"
                            Click="OnCancelClick" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BackButton"
                                Content="{DynamicResource Common.Back}"
                                Style="{StaticResource Btn.Secondary}"
                                Margin="0,0,10,0"
                                Click="OnBackClick" />
                        <Button x:Name="NextButton"
                                Content="{DynamicResource Common.Next}"
                                MinWidth="124"
                                Style="{StaticResource Btn.Primary}"
                                Click="OnNextClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

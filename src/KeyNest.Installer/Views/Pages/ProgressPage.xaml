<pages:WizardPage x:Class="KeyNest.Installer.Views.Pages.ProgressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:KeyNest.Installer.Views.Pages"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="8,0,8,0">
            <TextBlock Text="{DynamicResource Installer.Progress.Title}" Style="{StaticResource Text.Display}" />
            <TextBlock Text="{DynamicResource Installer.Progress.Description}"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,4,0,14" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="8,6,8,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Body}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding ProgressValue, StringFormat={}{0:P0}}"
                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <ProgressBar Style="{StaticResource Bar.Progress}"
                                 Margin="0,14,0,0"
                                 Minimum="0"
                                 Maximum="1"
                                 Value="{Binding ProgressValue}" />
                </StackPanel>
            </Border>

            <!-- 需要管理员权限 -->
            <Border x:Name="ElevationPanel"
                    Style="{StaticResource Card}"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Installer.Progress.ElevationTitle}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                               Text="{DynamicResource Installer.Progress.ElevationDescription}" />
                    <Button Content="{DynamicResource Installer.Progress.ElevationButton}"
                            Style="{StaticResource Btn.Primary}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Click="OnElevateClick" />
                </StackPanel>
            </Border>

            <!-- 安装失败重试 -->
            <Border x:Name="RetryPanel"
                    Style="{StaticResource Card}"
                    Margin="0,14,0,0"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Installer.Progress.RetryTitle}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                    <TextBlock Text="{DynamicResource Installer.Progress.RetryDescription}"
                               Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                    <Button Content="{DynamicResource Common.Retry}"
                            Style="{StaticResource Btn.Secondary}"
                            HorizontalAlignment="Left"
                            Margin="0,12,0,0"
                            Click="OnRetryClick" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Text.Tertiary}" Margin="0,14,0,0"
                       Text="{DynamicResource Installer.Progress.Footnote}" />
        </StackPanel>
    </Grid>
</pages:WizardPage>

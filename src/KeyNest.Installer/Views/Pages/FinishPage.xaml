<pages:WizardPage x:Class="KeyNest.Installer.Views.Pages.FinishPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:KeyNest.Installer.Views.Pages"
             xmlns:ui="clr-namespace:KeyNest.UI.Controls;assembly=KeyNest.UI"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="8,0,8,0">
            <TextBlock Text="{DynamicResource Installer.Finish.Title}" Style="{StaticResource Text.Display}" />
            <TextBlock Text="{DynamicResource Installer.Finish.Description}"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,4,0,14" />
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="8,4,8,0">
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush.BrandSoft}">
                            <Viewbox Margin="11">
                                <Canvas Width="24" Height="24">
                                    <Path Data="M4,12.5 L9.5,18 L20,6.5"
                                          Stroke="{DynamicResource Brush.Brand}"
                                          StrokeThickness="2.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Installer.Finish.InstalledTitle}" Style="{StaticResource Text.Section}" />
                            <TextBlock Text="{Binding InstallPath}" Style="{StaticResource Text.Tertiary}" />
                        </StackPanel>
                    </StackPanel>

                    <Border Style="{StaticResource Divider}" Margin="0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Installer.Finish.RunNowTitle}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                            <TextBlock Text="{DynamicResource Installer.Finish.RunNowDescription}"
                                       Style="{StaticResource Text.Caption}" Margin="0,2,12,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1"
                                         IsChecked="{Binding RunNow, Mode=TwoWay}"
                                         VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card.Subtle}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Installer.Finish.NextTitle}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
                               Text="{DynamicResource Installer.Finish.NextDescription}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card.Subtle}" Margin="0,12,0,0">
                <TextBlock Style="{StaticResource Text.Caption}"
                           Text="{DynamicResource Installer.Finish.Footnote}" />
            </Border>
        </StackPanel>
    </Grid>
</pages:WizardPage>

<pages:WizardPage x:Class="KeyNest.Installer.Views.Pages.LicensePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:KeyNest.Installer.Views.Pages"
             xmlns:ui="clr-namespace:KeyNest.UI.Controls;assembly=KeyNest.UI"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="8,0,8,0">
            <TextBlock Text="{DynamicResource Installer.License.Title}" Style="{StaticResource Text.Display}" />
            <TextBlock Text="{DynamicResource Installer.License.Description}"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,4,0,14" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="8,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Installer.License.Section1Title}" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,14"
                               Text="{DynamicResource Installer.License.Section1Body}" />

                    <TextBlock Text="{DynamicResource Installer.License.Section2Title}" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,14"
                               Text="{DynamicResource Installer.License.Section2Body}" />

                    <TextBlock Text="{DynamicResource Installer.License.Section3Title}" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,14"
                               Text="{DynamicResource Installer.License.Section3Body}" />

                    <TextBlock Text="{DynamicResource Installer.License.Section4Title}" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,14"
                               Text="{DynamicResource Installer.License.Section4Body}" />

                    <TextBlock Text="{DynamicResource Installer.License.Section5Title}" Style="{StaticResource Text.Section}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                               Text="{DynamicResource Installer.License.Section5Body}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="8,16,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{DynamicResource Installer.License.Accept}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                <TextBlock Text="{DynamicResource Installer.License.AcceptHint}" Style="{StaticResource Text.Tertiary}" Margin="0,2,0,0" />
            </StackPanel>
            <ui:ToggleSwitch Grid.Column="1"
                             IsChecked="{Binding LicenseAccepted, Mode=TwoWay}"
                             VerticalAlignment="Center" />
        </Grid>
    </Grid>
</pages:WizardPage>

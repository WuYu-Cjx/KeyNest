<pages:WizardPage x:Class="KeyNest.Installer.Views.Pages.DirectoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:KeyNest.Installer.Views.Pages"
             FontFamily="{DynamicResource Font.Ui}">
    <pages:WizardPage.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="PathBox" TargetType="TextBox">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource Brush.CardAlt}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd"
                                CornerRadius="{DynamicResource Radius.Button}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Brand}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </pages:WizardPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="8,0,8,0">
            <TextBlock Text="{DynamicResource Installer.Directory.Title}" Style="{StaticResource Text.Display}" />
            <TextBlock Text="{DynamicResource Installer.Directory.Description}"
                       Style="{StaticResource Text.Caption}"
                       Margin="0,4,0,14" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="8,0,8,8">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Installer.Directory.ScopeTitle}" Style="{StaticResource Text.Section}" Margin="0,0,0,10" />

                        <RadioButton Style="{StaticResource Radio.Option}"
                                     GroupName="Scope"
                                     IsChecked="{Binding IsPerUser, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Installer.Directory.PerUserTitle}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Installer.Directory.PerUserDescription}"
                                           Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </RadioButton>

                        <Border Style="{StaticResource Divider}" Margin="0,10" />

                        <RadioButton Style="{StaticResource Radio.Option}"
                                     GroupName="Scope"
                                     IsChecked="{Binding IsPerMachineSelected, Mode=TwoWay}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Installer.Directory.PerMachineTitle}" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource Installer.Directory.PerMachineDescription}"
                                           Style="{StaticResource Text.Caption}" />
                            </StackPanel>
                        </RadioButton>

                        <TextBlock Text="{Binding ScopeNote}" Style="{StaticResource Text.Tertiary}" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Installer.Directory.LocationTitle}" Style="{StaticResource Text.Section}" Margin="0,0,0,8" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource PathBox}"
                                     Text="{Binding TargetDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Grid.Column="1"
                                    Content="{DynamicResource Common.Browse}"
                                    Style="{StaticResource Btn.Secondary}"
                                    Margin="10,0,0,0"
                                    MinWidth="88"
                                    Click="OnBrowseClick" />
                        </Grid>

                        <TextBlock Text="{Binding ValidationMessage}" Margin="0,8,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsTargetValid}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Subtle}"
                        Margin="0,12,0,0"
                        Visibility="{Binding HasPreviousVersion, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding PreviousVersionText}" Style="{StaticResource Text.Caption}" />
                </Border>

                <Border Style="{StaticResource Card.Subtle}" Margin="0,12,0,0">
                    <TextBlock Style="{StaticResource Text.Caption}"
                               Text="{DynamicResource Installer.Directory.Footnote}" />
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</pages:WizardPage>

<pages:WizardPage x:Class="KeyNest.Installer.Views.Pages.WelcomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:KeyNest.Installer.Views.Pages"
             FontFamily="{DynamicResource Font.Ui}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center" Margin="8,10,8,0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="62" Height="62" CornerRadius="20" Background="{DynamicResource Brush.BrandSoft}">
                        <Viewbox Margin="13">
                            <Canvas Width="32" Height="32">
                                <Path Data="M6,22 C6,14.6 10.5,9.6 16,9.6 C21.5,9.6 26,14.6 26,22"
                                      Stroke="{DynamicResource Brush.Brand}"
                                      StrokeThickness="2.8"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" />
                                <Ellipse Canvas.Left="13.2" Canvas.Top="17" Width="5.6" Height="5.6" Fill="{DynamicResource Brush.Brand}" />
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Installer.Welcome.Title}"
                                   FontFamily="{DynamicResource Font.Display}"
                                   FontSize="24"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="{DynamicResource Installer.Welcome.Subtitle}"
                                   FontSize="13.5"
                                   Margin="0,4,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Text="{DynamicResource Installer.Welcome.Description}"
                           Style="{StaticResource Text.Caption}"
                           Margin="0,14,0,0"
                           MaxWidth="660"
                           HorizontalAlignment="Left" />

                <!-- 安装语言 -->
                <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Installer.Welcome.LanguageTitle}"
                                   Style="{StaticResource Text.Section}" />
                        <TextBlock Text="{DynamicResource Installer.Welcome.LanguageDescription}"
                                   Style="{StaticResource Text.Caption}"
                                   Margin="0,4,0,10" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <RadioButton Style="{StaticResource Radio.Option}"
                                         GroupName="SetupLanguage"
                                         IsChecked="{Binding LanguageChinese, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.Language.ChineseTitle}"
                                               FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Settings.Language.ChineseDescription}"
                                               Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton Grid.Column="1"
                                         Style="{StaticResource Radio.Option}"
                                         GroupName="SetupLanguage"
                                         IsChecked="{Binding LanguageEnglish, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.Language.EnglishTitle}"
                                               FontSize="13" FontWeight="SemiBold" />
                                    <TextBlock Text="{DynamicResource Settings.Language.EnglishDescription}"
                                               Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                            </RadioButton>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card.Subtle}" Margin="0,12,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Brand}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Text.Body}"
                                       Text="{DynamicResource Installer.Welcome.Feature1}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Brand}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Text.Body}"
                                       Text="{DynamicResource Installer.Welcome.Feature2}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Brand}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Margin="10,0,0,0" Style="{StaticResource Text.Body}"
                                       Text="{DynamicResource Installer.Welcome.Feature3}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock Grid.Row="1"
                   Text="{DynamicResource Installer.Welcome.Footnote}"
                   Style="{StaticResource Text.Tertiary}"
                   Margin="8,12,8,0" />
    </Grid>
</pages:WizardPage>

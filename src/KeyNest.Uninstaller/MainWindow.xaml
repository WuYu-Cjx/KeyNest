<Window x:Class="KeyNest.Uninstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KeyNest.UI.Controls;assembly=KeyNest.UI"
        Title="{DynamicResource Uninstaller.WindowTitle}"
        Width="580"
        Height="440"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="{DynamicResource Font.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Border Margin="14"
            CornerRadius="{DynamicResource Radius.Window}"
            Background="{DynamicResource Brush.Window}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Effect="{StaticResource Shadow.Dialog}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0"
                  Height="64"
                  Margin="22,0,10,0"
                  Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="34" Height="34" CornerRadius="11" Background="{DynamicResource Brush.BrandSoft}">
                    <Viewbox Margin="8">
                        <Canvas Width="32" Height="32">
                            <Path Data="M6,22 C6,14.6 10.5,9.6 16,9.6 C21.5,9.6 26,14.6 26,22"
                                  Stroke="{DynamicResource Brush.Brand}"
                                  StrokeThickness="2.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="13.2" Canvas.Top="17" Width="5.6" Height="5.6" Fill="{DynamicResource Brush.Brand}" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Uninstaller.WindowTitle}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{DynamicResource App.Tagline}" FontSize="11"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>

                <Button Grid.Column="2" Width="34" Height="30" Style="{StaticResource Btn.Ghost}" Padding="0"
                        Click="OnCloseClick" ToolTip="{DynamicResource Common.Close}">
                    <Path Data="M0,0 L10,10 M10,0 L0,10"
                          Width="10" Height="10" Stretch="Uniform"
                          Stroke="{DynamicResource Brush.TextSecondary}"
                          StrokeThickness="1.4"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="22,0,22,0">
                <StackPanel>
                    <!-- 选项区 -->
                    <StackPanel x:Name="OptionsPanel">
                        <TextBlock Text="{DynamicResource Uninstaller.Heading}" Style="{StaticResource Text.Display}" FontSize="20" />
                        <TextBlock Text="{DynamicResource Uninstaller.Description}"
                                   Style="{StaticResource Text.Caption}" Margin="0,6,0,14" />

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Uninstaller.KeepConfigTitle}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource Uninstaller.KeepConfigDescription}"
                                                   Style="{StaticResource Text.Caption}" Margin="0,2,12,0" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1"
                                                     IsChecked="{Binding KeepUserConfig, Mode=TwoWay}"
                                                     VerticalAlignment="Center" />
                                </Grid>

                                <Border Style="{StaticResource Divider}" Margin="0,14" />

                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Uninstaller.InstallDirectoryLabel}" Style="{StaticResource Text.Caption}" />
                                    <TextBlock Text="{Binding InstallDirectory}"
                                               Style="{StaticResource Text.Tertiary}"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 进度区 -->
                    <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Text="{DynamicResource Uninstaller.ProgressTitle}" Style="{StaticResource Text.Display}" FontSize="20" />
                        <TextBlock x:Name="StatusText" Text="{DynamicResource Uninstaller.Preparing}"
                                   Style="{StaticResource Text.Caption}" Margin="0,6,0,14" />
                        <ProgressBar Style="{StaticResource Bar.Progress}" Height="6" IsIndeterminate="True" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2"
                    Padding="22,14"
                    BorderBrush="{DynamicResource Brush.Divider}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button x:Name="CancelButton"
                            Content="{DynamicResource Uninstaller.Cancel}"
                            Style="{StaticResource Btn.Ghost}"
                            HorizontalAlignment="Left"
                            Click="OnCloseClick" />

                    <Button x:Name="UninstallButton"
                            Grid.Column="1"
                            Content="{DynamicResource Uninstaller.Uninstall}"
                            MinWidth="120"
                            Style="{StaticResource Btn.Danger}"
                            Click="OnUninstallClick" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

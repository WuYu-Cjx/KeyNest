<Application x:Class="KeyNest.Uninstaller.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/KeyNest.UI;component/Themes/Tokens.xaml" />
                <ResourceDictionary Source="pack://application:,,,/KeyNest.UI;component/Themes/Light.xaml" />
                <ResourceDictionary Source="pack://application:,,,/KeyNest.UI;component/Themes/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/KeyNest.UI;component/Resources/Strings.zh-CN.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

    <!-- ===== App ===== -->
    <sys:String x:Key="App.ProductName">KeyNest</sys:String>
    <sys:String x:Key="App.ProductFullName">KeyNest</sys:String>
    <sys:String x:Key="App.Tagline">Every shortcut, right where you need it.</sys:String>
    <sys:String x:Key="App.ShortTagline">KeyNest · Every shortcut, right where you need it.</sys:String>
    <sys:String x:Key="App.Settings">Settings</sys:String>
    <sys:String x:Key="App.SettingsWindowTitle">KeyNest Settings</sys:String>
    <sys:String x:Key="App.Minimize">Minimize</sys:String>
    <sys:String x:Key="App.Close">Close</sys:String>

    <!-- ===== Tray ===== -->
    <sys:String x:Key="Tray.TitleIdle">KeyNest — Not listening</sys:String>
    <sys:String x:Key="Tray.TitleListening">KeyNest — Listening</sys:String>
    <sys:String x:Key="Tray.Enable">Enable</sys:String>
    <sys:String x:Key="Tray.Disable">Disable</sys:String>
    <sys:String x:Key="Tray.ShowPanel">Show overlay</sys:String>
    <sys:String x:Key="Tray.HidePanel">Hide overlay</sys:String>
    <sys:String x:Key="Tray.Settings">Settings…</sys:String>
    <sys:String x:Key="Tray.AutoStart">Start with Windows</sys:String>
    <sys:String x:Key="Tray.Exit">Exit KeyNest</sys:String>
    <sys:String x:Key="Tray.HookFailed">Unable to enable listening: the system rejected the keyboard hook.</sys:String>

    <!-- ===== Floating window ===== -->
    <sys:String x:Key="Floating.Title">KeyNest</sys:String>
    <sys:String x:Key="Floating.Prompt">Press a modifier key to see shortcuts</sys:String>
    <sys:String x:Key="Floating.PrefixTitleFormat">Shortcuts with {0}</sys:String>
    <sys:String x:Key="Floating.OverviewTag">All</sys:String>
    <sys:String x:Key="Floating.OverviewTitle">All shortcuts</sys:String>
    <sys:String x:Key="Floating.Empty">No matching shortcuts.</sys:String>
    <sys:String x:Key="Floating.Footer">KeyNest only shows shortcut descriptions and never executes them · Release all modifiers to hide · Esc to close</sys:String>
    <sys:String x:Key="Floating.NoModifiers">No modifier</sys:String>
    <sys:String x:Key="Floating.CountFormat">{0} items</sys:String>

    <!-- ===== Settings: tabs ===== -->
    <sys:String x:Key="Settings.Tab.General">General</sys:String>
    <sys:String x:Key="Settings.Tab.Theme">Theme</sys:String>
    <sys:String x:Key="Settings.Tab.Floating">Overlay</sys:String>
    <sys:String x:Key="Settings.Tab.Triggers">Triggering</sys:String>
    <sys:String x:Key="Settings.Tab.Language">Language</sys:String>
    <sys:String x:Key="Settings.Tab.About">About &amp; Licenses</sys:String>

    <!-- ===== Settings: general ===== -->
    <sys:String x:Key="Settings.General.Title">General</sys:String>
    <sys:String x:Key="Settings.General.Description">KeyNest only shows shortcut descriptions. It never executes shortcuts and never keeps a key history.</sys:String>
    <sys:String x:Key="Settings.General.AutoStartTitle">Start with Windows in the tray</sys:String>
    <sys:String x:Key="Settings.General.AutoStartDescription">Stays in the tray after startup, does not listen by default and never opens the overlay automatically.</sys:String>
    <sys:String x:Key="Settings.General.SingleInstanceTitle">Single instance</sys:String>
    <sys:String x:Key="Settings.General.SingleInstanceDescription">Only one KeyNest process is allowed per user session. Opening the shortcut again brings up the settings window.</sys:String>
    <sys:String x:Key="Settings.General.NoAutoListenTitle">Do not listen on startup</sys:String>
    <sys:String x:Key="Settings.General.NoAutoListenDescription">To stay quiet and unobtrusive, KeyNest always starts without listening. Enable it from the tray menu when needed.</sys:String>
    <sys:String x:Key="Settings.General.Footnote">Disabling listening uninstalls the keyboard hook and hides the overlay immediately. Exiting releases the tray icon and ends the process.</sys:String>

    <!-- ===== Settings: theme ===== -->
    <sys:String x:Key="Settings.Theme.Title">Theme</sys:String>
    <sys:String x:Key="Settings.Theme.Description">Changes apply immediately and are saved automatically. The default follows the system.</sys:String>
    <sys:String x:Key="Settings.Theme.SystemTitle">Follow system</sys:String>
    <sys:String x:Key="Settings.Theme.SystemDescription">Switches in real time with the Windows light and dark mode.</sys:String>
    <sys:String x:Key="Settings.Theme.LightTitle">Light</sys:String>
    <sys:String x:Key="Settings.Theme.LightDescription">Bright background, suited to daytime or well-lit environments.</sys:String>
    <sys:String x:Key="Settings.Theme.DarkTitle">Dark</sys:String>
    <sys:String x:Key="Settings.Theme.DarkDescription">Dark background, suited to nighttime or low-light environments.</sys:String>
    <sys:String x:Key="Settings.Theme.HighContrastNote">When Windows high contrast or reduced animations are enabled, KeyNest automatically uses the high-contrast palette and skips transitions.</sys:String>

    <!-- ===== Settings: overlay ===== -->
    <sys:String x:Key="Settings.Floating.Title">Overlay</sys:String>
    <sys:String x:Key="Settings.Floating.Description">Rounded, translucent and non-activating. Drag the header to move it. It appears when any modifier is pressed and hides as soon as all modifiers are released.</sys:String>
    <sys:String x:Key="Settings.Floating.OpacityTitle">Opacity</sys:String>
    <sys:String x:Key="Settings.Floating.TakeoverWinTitle">Take over single Win</sys:String>
    <sys:String x:Key="Settings.Floating.TakeoverWinDescription">Off by default. When enabled, pressing Win alone shows the overlay instead of the Start menu; Win with other keys keeps the system behavior.</sys:String>
    <sys:String x:Key="Settings.Floating.IncludeNoModifierTitle">Include modifier-free shortcuts</sys:String>
    <sys:String x:Key="Settings.Floating.IncludeNoModifierDescription">Off by default. When enabled, single keys such as F5, Delete and Esc are listed only while the overlay is already open; pressing them alone never opens the overlay.</sys:String>
    <sys:String x:Key="Settings.Floating.PositionTitle">Overlay position</sys:String>
    <sys:String x:Key="Settings.Floating.PositionDescription">Shown centered near the bottom of the screen at first; the position is remembered after dragging.</sys:String>
    <sys:String x:Key="Settings.Floating.ResetPosition">Reset position</sys:String>

    <!-- ===== Settings: triggers ===== -->
    <sys:String x:Key="Settings.Triggers.Title">Triggering</sys:String>
    <sys:String x:Key="Settings.Triggers.Description">Any non-empty modifier combination triggers the overlay. The more complete the combination, the more focused the list.</sys:String>
    <sys:String x:Key="Settings.Triggers.RuleTitle">Matching rule</sys:String>
    <sys:String x:Key="Settings.Triggers.RuleDescription">Let P be the set of modifiers currently held and K the modifier set of a shortcut. An entry is listed only when (K &amp; P) == P. Groups exactly equal to P come first, followed by groups with one extra modifier, then two.</sys:String>
    <sys:String x:Key="Settings.Triggers.SingleTitle">Single modifier</sys:String>
    <sys:String x:Key="Settings.Triggers.SingleDescription">Holding Ctrl lists every shortcut that contains Ctrl; holding Alt lists every shortcut that contains Alt.</sys:String>
    <sys:String x:Key="Settings.Triggers.PairTitle">Two-modifier combinations</sys:String>
    <sys:String x:Key="Settings.Triggers.PairDescription">Holding Ctrl+Alt shows only shortcuts that contain both Ctrl and Alt (for example Ctrl+Alt+Delete) and never mixes in Ctrl-only entries.</sys:String>
    <sys:String x:Key="Settings.Triggers.MultiTitle">Three- and four-modifier combinations</sys:String>
    <sys:String x:Key="Settings.Triggers.MultiDescription">For example Ctrl+Shift+Esc, Win+Ctrl+D, Win+Shift+S and Win+Ctrl+Shift+B. Entries first satisfy “contains the current set”, then are grouped by the number of extra modifiers.</sys:String>
    <sys:String x:Key="Settings.Triggers.RealtimeTitle">Narrowing and expanding live</sys:String>
    <sys:String x:Key="Settings.Triggers.RealtimeDescription">After opening the Ctrl list, pressing Alt narrows it to entries that contain both Ctrl and Alt; releasing Alt restores the Ctrl list. Releasing all modifiers hides the overlay immediately.</sys:String>
    <sys:String x:Key="Settings.Triggers.NoModifierNote">Modifier-free single keys (F1–F12, Delete, Esc and so on) never open the overlay by themselves, to avoid interrupting typing. Enable the supplementary list under Overlay if needed.</sys:String>

    <!-- ===== Settings: language ===== -->
    <sys:String x:Key="Settings.Language.Title">Language</sys:String>
    <sys:String x:Key="Settings.Language.Description">Choose the interface language. It applies immediately and is saved automatically. Simplified Chinese is the default.</sys:String>
    <sys:String x:Key="Settings.Language.ChineseTitle">简体中文</sys:String>
    <sys:String x:Key="Settings.Language.ChineseDescription">使用简体中文界面与快捷键说明。</sys:String>
    <sys:String x:Key="Settings.Language.EnglishTitle">English</sys:String>
    <sys:String x:Key="Settings.Language.EnglishDescription">Use the English interface and shortcut descriptions.</sys:String>
    <sys:String x:Key="Settings.Language.Note">Language and theme are independent. Switching the language never changes the theme and never reloads the shortcut matching logic.</sys:String>

    <!-- ===== Settings: about ===== -->
    <sys:String x:Key="Settings.About.Title">About &amp; Licenses</sys:String>
    <sys:String x:Key="Settings.About.VersionFormat">Version {0}</sys:String>
    <sys:String x:Key="Settings.About.PrivacyTitle">Privacy</sys:String>
    <sys:String x:Key="Settings.About.PrivacyDescription">KeyNest does not connect to the internet or any server, uploads no data, keeps no key history and stores no typed content. Only the interface language, theme, overlay position and opacity, trigger and display options, and the auto-start flag are saved locally.</sys:String>
    <sys:String x:Key="Settings.About.AuthorTitle">Author and project</sys:String>
    <sys:String x:Key="Settings.About.AuthorLabel">Author:&#x20;</sys:String>
    <sys:String x:Key="Settings.About.ProjectLabel">Repository:&#x20;</sys:String>
    <sys:String x:Key="Settings.About.LicensesTitle">Third-party components and licenses</sys:String>
    <sys:String x:Key="Settings.About.OpenLicenseList">Open list</sys:String>
    <sys:String x:Key="Settings.About.DataTitle">Data and uninstall</sys:String>
    <sys:String x:Key="Settings.About.OpenDataFolder">Open data folder</sys:String>
    <sys:String x:Key="Settings.About.Uninstall">Uninstall KeyNest</sys:String>
    <sys:String x:Key="Settings.About.LicenseSummary">Third-party components (runtime)&#10;· .NET 8 / WPF / Windows Forms — MIT — runtime framework published by Microsoft&#10;· Windows public APIs (user32.dll / dwmapi.dll / kernel32.dll) — system components — keyboard hook, window styles, DWM rounded corners&#10;&#10;This program contains no GPL/AGPL components, no networking and no telemetry, and it never records key history or typed content.&#10;It uses the built-in Segoe UI / Segoe UI Variable fonts and bundles no third-party fonts.&#10;The icon is an original drawing and uses no Windows system icons or commercial icon libraries.&#10;See THIRD-PARTY-NOTICES.txt in the installation folder for the complete list.</sys:String>


    <sys:String x:Key="Uninstaller.Heading">Uninstall KeyNest</sys:String>
    <sys:String x:Key="Uninstaller.Description">This removes the program files, shortcuts, auto-start entry and uninstall information.</sys:String>
    <sys:String x:Key="Uninstaller.KeepConfigTitle">Keep user settings</sys:String>
    <sys:String x:Key="Uninstaller.KeepConfigDescription">Keeps the interface language, theme, overlay position and display options under %APPDATA%\KeyNest.</sys:String>

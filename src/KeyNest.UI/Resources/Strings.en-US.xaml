    <sys:String x:Key="Settings.Error.LicenseMissing">Third-party license file not found.</sys:String>
    <sys:String x:Key="Settings.Error.OpenLicenseFormat">Unable to open the license file: {0}</sys:String>
    <sys:String x:Key="Settings.Error.OpenLinkFormat">Unable to open the link: {0}</sys:String>
    <sys:String x:Key="Settings.Uninstall.Missing">Uninstaller not found. Uninstall KeyNest from Windows Settings → Apps → Installed apps.</sys:String>
    <sys:String x:Key="Settings.Uninstall.Confirm">The uninstaller will start and KeyNest will exit first. Continue?</sys:String>
    <sys:String x:Key="Settings.Uninstall.StartFailedFormat">Unable to start the uninstaller: {0}</sys:String>

    <!-- ===== Installer ===== -->
    <sys:String x:Key="Installer.WindowTitle">KeyNest Setup</sys:String>
    <sys:String x:Key="Installer.StepFormat">Step {0} of {1}</sys:String>
    <sys:String x:Key="Installer.ContinueError">An error occurred while continuing the installation:&#10;{0}</sys:String>
    <sys:String x:Key="Installer.UnexpectedError">The installer encountered an unhandled error:&#10;{0}</sys:String>
    <sys:String x:Key="Installer.CancelBusyConfirm">The installation is in progress. Cancel and close anyway? Some files may already have been written.</sys:String>

    <sys:String x:Key="Installer.Welcome.Title">Welcome to KeyNest</sys:String>
    <sys:String x:Key="Installer.Welcome.Subtitle">Every shortcut, right where you need it.</sys:String>
    <sys:String x:Key="Installer.Welcome.Description">KeyNest is a fully local Windows shortcut reference: hold any modifier combination (Ctrl, Shift, Alt, Win and their combinations) to see the available shortcuts.</sys:String>
    <sys:String x:Key="Installer.Welcome.LanguageTitle">Setup language</sys:String>
    <sys:String x:Key="Installer.Welcome.LanguageDescription">Choose the language used by the installer and the KeyNest interface. You can change it later in Settings.</sys:String>
    <sys:String x:Key="Installer.Welcome.Feature1">Fully offline: no networking, no data upload and no telemetry.</sys:String>
    <sys:String x:Key="Installer.Welcome.Feature2">Shows only, never executes: no key history, no stored input and no interception of system shortcuts.</sys:String>
    <sys:String x:Key="Installer.Welcome.Feature3">Stays in the tray after installation and does not listen by default. Enable or exit at any time from the tray menu.</sys:String>
    <sys:String x:Key="Installer.Welcome.Footnote">This installer downloads nothing; all files come from the package itself.</sys:String>

    <sys:String x:Key="Installer.License.Title">License and privacy</sys:String>
    <sys:String x:Key="Installer.License.Description">Please read the following before continuing. KeyNest does not connect to the internet and collects no personal information.</sys:String>
    <sys:String x:Key="Installer.License.Section1Title">1. License</sys:String>
    <sys:String x:Key="Installer.License.Section1Body">This software is provided free of charge for personal use on Windows devices. You may copy and distribute the unmodified original installer, but you may not remove the product name or copyright notices, and you may not use the software for illegal purposes.</sys:String>
    <sys:String x:Key="Installer.License.Section2Title">2. Functional boundaries</sys:String>
    <sys:String x:Key="Installer.License.Section2Body">KeyNest only displays built-in shortcut descriptions. It never executes shortcuts, forwards keystrokes or changes system settings. System keys are not intercepted by default, so Win+R, Win+D and other system shortcuts keep their normal behavior.</sys:String>
    <sys:String x:Key="Installer.License.Section3Title">3. Privacy</sys:String>
    <sys:String x:Key="Installer.License.Section3Body">KeyNest does not connect to the internet or any server, uploads no data, keeps no key history and stores no typed content. Only settings such as the interface language, theme, overlay position and opacity, trigger and display options, and the auto-start flag are saved locally under %APPDATA%\KeyNest.</sys:String>
    <sys:String x:Key="Installer.License.Section4Title">4. Open source and third-party components</sys:String>
    <sys:String x:Key="Installer.License.Section4Body">KeyNest uses only the .NET 8 runtime and public Windows APIs, with no GPL/AGPL components. The third-party notices are installed as THIRD-PARTY-NOTICES.txt in the installation folder and can be viewed at any time.</sys:String>
    <sys:String x:Key="Installer.License.Section5Title">5. Disclaimer</sys:String>
    <sys:String x:Key="Installer.License.Section5Body">Shortcut descriptions reflect official Windows behavior and may differ between system versions. This software is provided “as is”, without liability for any loss caused by using or being unable to use it.</sys:String>
    <sys:String x:Key="Installer.License.Accept">I accept the license and privacy notice</sys:String>
    <sys:String x:Key="Installer.License.AcceptHint">You must accept before continuing.</sys:String>

    <sys:String x:Key="Installer.Directory.Title">Install location</sys:String>
    <sys:String x:Key="Installer.Directory.Description">Choose the installation scope and target folder. The default folder has already been validated and can be used directly.</sys:String>
    <sys:String x:Key="Installer.Directory.ScopeTitle">Installation scope</sys:String>
    <sys:String x:Key="Installer.Directory.PerUserTitle">Install for the current user only (recommended)</sys:String>
    <sys:String x:Key="Installer.Directory.PerUserDescription">Installs to %LocalAppData%\Programs\KeyNest by default; administrator rights are not required.</sys:String>
    <sys:String x:Key="Installer.Directory.PerMachineTitle">Install for all users</sys:String>
    <sys:String x:Key="Installer.Directory.PerMachineDescription">Installs to %ProgramFiles%\KeyNest by default; administrator rights are required.</sys:String>
    <sys:String x:Key="Installer.Directory.LocationTitle">Folder</sys:String>
    <sys:String x:Key="Installer.Directory.Footnote">This folder holds the program files and the uninstaller. User settings always live in %APPDATA%\KeyNest, independent of the installation folder.</sys:String>
    <sys:String x:Key="Installer.Directory.BrowseTitle">Choose the KeyNest installation folder</sys:String>
    <sys:String x:Key="Installer.Directory.ScopeNotePerUser">Installs only in the current user's folder; no administrator rights required.</sys:String>
    <sys:String x:Key="Installer.Directory.ScopeNotePerMachine">Installs for all users; administrator rights required.</sys:String>
    <sys:String x:Key="Installer.Directory.PreviousVersionFormat">KeyNest {0} is already installed. Continuing will overwrite the program files; your settings are preserved.</sys:String>

    <sys:String x:Key="Installer.Options.Title">Installation options</sys:String>
    <sys:String x:Key="Installer.Options.Description">Choose the shortcuts and startup behavior to create. All of these can be changed later in KeyNest Settings.</sys:String>
    <sys:String x:Key="Installer.Options.DesktopTitle">Create a desktop shortcut</sys:String>
    <sys:String x:Key="Installer.Options.DesktopDescription">Places a KeyNest shortcut on the desktop.</sys:String>
    <sys:String x:Key="Installer.Options.StartMenuTitle">Create Start menu entries</sys:String>
    <sys:String x:Key="Installer.Options.StartMenuDescription">Adds the program and uninstall entries to the Start menu.</sys:String>
    <sys:String x:Key="Installer.Options.AutoStartTitle">Start with Windows in the tray</sys:String>
    <sys:String x:Key="Installer.Options.AutoStartDescription">Off by default. Even when enabled, KeyNest still starts without listening and only stays in the tray.</sys:String>
    <sys:String x:Key="Installer.Options.AutoStartNoteTitle">About auto-start and listening</sys:String>
    <sys:String x:Key="Installer.Options.AutoStartNote">Auto-start only writes the current user's Run value named KeyNest; it never registers a system service. Listening is controlled entirely by you from the tray menu.</sys:String>
    <sys:String x:Key="Installer.Options.Footnote">You can adjust everything later under Tray menu → Settings. The uninstaller lets you choose whether to keep your settings.</sys:String>

    <sys:String x:Key="Installer.Progress.Title">Installing</sys:String>
    <sys:String x:Key="Installer.Progress.Description">Please wait. The installation happens entirely on this machine and downloads nothing.</sys:String>
    <sys:String x:Key="Installer.Progress.Preparing">Preparing to install.</sys:String>
    <sys:String x:Key="Installer.Progress.ElevationTitle">Administrator rights required</sys:String>
    <sys:String x:Key="Installer.Progress.ElevationDescription">You selected “Install for all users”. Restart the installer as administrator and select this option again.</sys:String>
    <sys:String x:Key="Installer.Progress.ElevationButton">Restart as administrator</sys:String>
    <sys:String x:Key="Installer.Progress.ElevationFailed">Unable to restart as administrator. Right-click the installer and choose “Run as administrator”.</sys:String>
    <sys:String x:Key="Installer.Progress.RetryTitle">Installation did not finish</sys:String>
    <sys:String x:Key="Installer.Progress.RetryDescription">Check the free disk space and folder permissions and try again, or cancel and choose another folder.</sys:String>
    <sys:String x:Key="Installer.Progress.Footnote">After installation you can adjust the language, theme, overlay and auto-start in KeyNest Settings.</sys:String>
    <sys:String x:Key="Installer.Progress.NeedElevationStatus">Per-machine installation requires administrator rights. Click the button below to restart the installer.</sys:String>
    <sys:String x:Key="Installer.Progress.DoneStatus">Installation complete. Click “Next” to finish.</sys:String>
    <sys:String x:Key="Installer.Progress.FailedStatusFormat">Installation failed: {0}</sys:String>

    <sys:String x:Key="Installer.Finish.Title">Installation complete</sys:String>
    <sys:String x:Key="Installer.Finish.Description">KeyNest is ready. Select the option below to launch it and enable listening right after installation.</sys:String>
    <sys:String x:Key="Installer.Finish.InstalledTitle">KeyNest has been installed</sys:String>
    <sys:String x:Key="Installer.Finish.RunNowTitle">Launch KeyNest and enable listening</sys:String>
    <sys:String x:Key="Installer.Finish.RunNowDescription">It stays in the tray and starts listening; you can disable it at any time from the tray menu.</sys:String>
    <sys:String x:Key="Installer.Finish.NextTitle">What to do next</sys:String>
    <sys:String x:Key="Installer.Finish.NextDescription">Choose “Enable” in the tray menu, then hold Ctrl, Shift, Alt, Win or any combination to see the shortcut descriptions. KeyNest only shows, never executes.</sys:String>
    <sys:String x:Key="Installer.Finish.Footnote">Your settings live in %APPDATA%\KeyNest and can be kept when uninstalling. Third-party notices are in THIRD-PARTY-NOTICES.txt in the installation folder.</sys:String>


<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深色主题语义色 -->

    <SolidColorBrush x:Key="Brush.Brand" Color="#6FBFA8" />
    <SolidColorBrush x:Key="Brush.BrandSoft" Color="#1E3A33" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#6FBFA8" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#8AD3BE" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#08110E" />

    <SolidColorBrush x:Key="Brush.Window" Color="#141917" />
    <SolidColorBrush x:Key="Brush.Card" Color="#1C2321" />
    <SolidColorBrush x:Key="Brush.CardAlt" Color="#232B28" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#28332F" />
    <SolidColorBrush x:Key="Brush.Border" Color="#303A36" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#2A3330" />

    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#EDF2F0" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A5B4AE" />
    <SolidColorBrush x:Key="Brush.TextTertiary" Color="#77857F" />

    <SolidColorBrush x:Key="Brush.Keycap" Color="#262E2B" />
    <SolidColorBrush x:Key="Brush.KeycapBorder" Color="#39443F" />
    <SolidColorBrush x:Key="Brush.KeycapText" Color="#E9F1EE" />

    <SolidColorBrush x:Key="Brush.Danger" Color="#E07B70" />
    <SolidColorBrush x:Key="Brush.Success" Color="#6BC79E" />

    <SolidColorBrush x:Key="Brush.TrackOff" Color="#3B4742" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#46534E" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="#5A6963" />
    <SolidColorBrush x:Key="Brush.Highlight" Color="#24443B" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#99000000" />

</ResourceDictionary>

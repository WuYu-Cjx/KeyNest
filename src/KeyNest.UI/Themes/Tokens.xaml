<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        键巢 KeyNest 设计令牌（原点原创设计）。
        与颜色无关的尺寸、圆角、字体、阴影集中在此；颜色由 Light/Dark/HighContrast 字典提供。
    -->

    <!-- 字体：只使用系统自带字体，不打包任何未授权字体 -->
    <FontFamily x:Key="Font.Ui">Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Display">Segoe UI Variable Display, Segoe UI Semibold, Microsoft YaHei UI</FontFamily>

    <!-- 圆角：窗口 16 / 卡片 12 / 按钮 9 / 键帽 7 -->
    <CornerRadius x:Key="Radius.Window">16</CornerRadius>
    <CornerRadius x:Key="Radius.Card">12</CornerRadius>
    <CornerRadius x:Key="Radius.Button">9</CornerRadius>
    <CornerRadius x:Key="Radius.Chip">7</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

    <!-- 间距刻度 -->
    <Thickness x:Key="Space.XS">4</Thickness>
    <Thickness x:Key="Space.S">8</Thickness>
    <Thickness x:Key="Space.M">12</Thickness>
    <Thickness x:Key="Space.L">16</Thickness>
    <Thickness x:Key="Space.XL">24</Thickness>

    <!-- 字号刻度 -->
    <sys:Double x:Key="Font.Size.Display">22</sys:Double>
    <sys:Double x:Key="Font.Size.Section">14.5</sys:Double>
    <sys:Double x:Key="Font.Size.Body">13</sys:Double>
    <sys:Double x:Key="Font.Size.Caption">12</sys:Double>

    <!-- 动效时长（毫秒）；系统关闭动画时由代码跳过动画 -->
    <sys:Double x:Key="Motion.FastMs">140</sys:Double>
    <sys:Double x:Key="Motion.NormalMs">220</sys:Double>

    <!-- 阴影 -->
    <DropShadowEffect x:Key="Shadow.Float"
                      Color="#000000"
                      BlurRadius="30"
                      ShadowDepth="10"
                      Direction="270"
                      Opacity="0.26" />
    <DropShadowEffect x:Key="Shadow.Dialog"
                      Color="#000000"
                      BlurRadius="40"
                      ShadowDepth="16"
                      Direction="270"
                      Opacity="0.30" />

</ResourceDictionary>

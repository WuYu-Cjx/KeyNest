<Window x:Class="KeyNest.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:KeyNest.UI.Controls;assembly=KeyNest.UI"
        Title="{DynamicResource App.SettingsWindowTitle}"
        Width="920"
        Height="648"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        FontFamily="{DynamicResource Font.Ui}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource Radius.Chip}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Hover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{DynamicResource Font.Ui}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Border Margin="14"
            CornerRadius="{DynamicResource Radius.Window}"
            Background="{DynamicResource Brush.Window}"
            BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1"
            Effect="{StaticResource Shadow.Dialog}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏 -->
            <Grid Grid.Row="0"
                  Height="54"
                  Margin="18,0,10,0"
                  Background="Transparent"
                  MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="28" Height="28" CornerRadius="9" Background="{DynamicResource Brush.BrandSoft}">
                    <Viewbox Margin="6">
                        <Canvas Width="32" Height="32">
                            <Path Data="M6,22 C6,14.6 10.5,9.6 16,9.6 C21.5,9.6 26,14.6 26,22"
                                  Stroke="{DynamicResource Brush.Brand}"
                                  StrokeThickness="2.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                            <Ellipse Canvas.Left="13.2" Canvas.Top="17" Width="5.6" Height="5.6" Fill="{DynamicResource Brush.Brand}" />
                        </Canvas>
                    </Viewbox>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource App.ProductName}" FontSize="13.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{DynamicResource App.Settings}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextTertiary}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ChromeButton}" Click="OnMinimizeClick" ToolTip="{DynamicResource App.Minimize}">
                        <Rectangle Width="10" Height="1.4" Fill="{DynamicResource Brush.TextSecondary}" />
                    </Button>
                    <Button Style="{StaticResource ChromeButton}" Margin="2,0,0,0" Click="OnCloseClick" ToolTip="{DynamicResource App.Close}">
                        <Path Data="M0,0 L10,10 M10,0 L0,10"
                              Width="10"
                              Height="10"
                              Stretch="Uniform"
                              Stroke="{DynamicResource Brush.TextSecondary}"
                              StrokeThickness="1.4"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="1" Style="{StaticResource NavTab}" SelectedIndex="0">

                <!-- ===== 常规 ===== -->
                <TabItem Header="{DynamicResource Settings.Tab.General}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,2,12,16">
                            <TextBlock Text="{DynamicResource Settings.General.Title}" Style="{StaticResource Text.Display}" />
                            <TextBlock Text="{DynamicResource Settings.General.Description}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,18" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings.General.AutoStartTitle}" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="{DynamicResource Settings.General.AutoStartDescription}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="0,3,12,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1"
                                                         IsChecked="{Binding AutoStart, Mode=TwoWay}"
                                                         VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.General.SingleInstanceTitle}" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Text="{DynamicResource Settings.General.SingleInstanceDescription}"
                                                   Style="{StaticResource Text.Caption}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>

                                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Settings.General.NoAutoListenTitle}" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Text="{DynamicResource Settings.General.NoAutoListenDescription}"
                                                   Style="{StaticResource Text.Caption}"
                                                   Margin="0,3,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card.Subtle}" Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Text="{DynamicResource Settings.General.Footnote}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 主题 ===== -->
                <TabItem Header="{DynamicResource Settings.Tab.Theme}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,2,12,16">
                            <TextBlock Text="{DynamicResource Settings.Theme.Title}" Style="{StaticResource Text.Display}" />
                            <TextBlock Text="{DynamicResource Settings.Theme.Description}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,18" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <RadioButton Style="{StaticResource Radio.Option}"
                                                 GroupName="ThemeMode"
                                                 IsChecked="{Binding ThemeFollowSystem, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings.Theme.SystemTitle}" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="{DynamicResource Settings.Theme.SystemDescription}"
                                                       Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </RadioButton>

                                    <Border Style="{StaticResource Divider}" Margin="0,12" />

                                    <RadioButton Style="{StaticResource Radio.Option}"
                                                 GroupName="ThemeMode"
                                                 IsChecked="{Binding ThemeLight, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings.Theme.LightTitle}" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="{DynamicResource Settings.Theme.LightDescription}"
                                                       Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </RadioButton>

                                    <Border Style="{StaticResource Divider}" Margin="0,12" />

                                    <RadioButton Style="{StaticResource Radio.Option}"
                                                 GroupName="ThemeMode"
                                                 IsChecked="{Binding ThemeDark, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings.Theme.DarkTitle}" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="{DynamicResource Settings.Theme.DarkDescription}"
                                                       Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource Text.Caption}"
                                       Margin="0,14,0,0"
                                       Text="{DynamicResource Settings.Theme.HighContrastNote}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 悬浮窗 ===== -->
                <TabItem Header="{DynamicResource Settings.Tab.Floating}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,2,12,16">
                            <TextBlock Text="{DynamicResource Settings.Floating.Title}" Style="{StaticResource Text.Display}" />
                            <TextBlock Text="{DynamicResource Settings.Floating.Description}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,18" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.Floating.OpacityTitle}" Style="{StaticResource SettingTitle}" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding OpacityText}"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Grid>
                                    <Slider Style="{StaticResource Slider.Slim}"
                                            Margin="0,6,0,0"
                                            Minimum="0.75"
                                            Maximum="1"
                                            SmallChange="0.01"
                                            LargeChange="0.05"
                                            Value="{Binding OpacityValue, Mode=TwoWay}" />

                                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings.Floating.TakeoverWinTitle}" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="{DynamicResource Settings.Floating.TakeoverWinDescription}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="0,3,12,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1"
                                                         IsChecked="{Binding TakeoverSingleWin, Mode=TwoWay}"
                                                         VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings.Floating.IncludeNoModifierTitle}" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="{DynamicResource Settings.Floating.IncludeNoModifierDescription}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="0,3,12,0" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1"
                                                         IsChecked="{Binding IncludeNoModifierKeys, Mode=TwoWay}"
                                                         VerticalAlignment="Center" />
                                    </Grid>

                                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings.Floating.PositionTitle}" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="{DynamicResource Settings.Floating.PositionDescription}"
                                                       Style="{StaticResource Text.Caption}"
                                                       Margin="0,3,12,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{DynamicResource Settings.Floating.ResetPosition}"
                                                Style="{StaticResource Btn.Secondary}"
                                                Command="{Binding ResetPositionCommand}"
                                                VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 触发说明 ===== -->
                <TabItem Header="{DynamicResource Settings.Tab.Triggers}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,2,12,16">
                            <TextBlock Text="{DynamicResource Settings.Triggers.Title}" Style="{StaticResource Text.Display}" />
                            <TextBlock Text="{DynamicResource Settings.Triggers.Description}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,18" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.Triggers.RuleTitle}" Style="{StaticResource Text.Section}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                               Text="{DynamicResource Settings.Triggers.RuleDescription}" />

                                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                                    <TextBlock Text="{DynamicResource Settings.Triggers.SingleTitle}" Style="{StaticResource SettingTitle}" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Border Style="{StaticResource Keycap}" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource Text.Key}" Text="Ctrl" />
                                        </Border>
                                        <Border Style="{StaticResource Keycap}" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource Text.Key}" Text="Shift" />
                                        </Border>
                                        <Border Style="{StaticResource Keycap}" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource Text.Key}" Text="Alt" />
                                        </Border>
                                        <Border Style="{StaticResource Keycap}" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource Text.Key}" Text="Win" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Text.Caption}"
                                               Text="{DynamicResource Settings.Triggers.SingleDescription}" />

                                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                                    <TextBlock Text="{DynamicResource Settings.Triggers.PairTitle}" Style="{StaticResource SettingTitle}" />
                                    <WrapPanel Margin="0,8,0,0">
                                        <Border Style="{StaticResource Keycap}" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource Text.Key}" Text="Ctrl+Alt" />
                                        </Border>
                                        <Border Style="{StaticResource Keycap}" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource Text.Key}" Text="Ctrl+Shift" />
                                        </Border>
                                        <Border Style="{StaticResource Keycap}" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource Text.Key}" Text="Ctrl+Win" />
                                        </Border>
                                        <Border Style="{StaticResource Keycap}" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource Text.Key}" Text="Alt+Shift" />
                                        </Border>
                                        <Border Style="{StaticResource Keycap}" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource Text.Key}" Text="Alt+Win" />
                                        </Border>
                                        <Border Style="{StaticResource Keycap}" Margin="0,0,8,8">
                                            <TextBlock Style="{StaticResource Text.Key}" Text="Shift+Win" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock Style="{StaticResource Text.Caption}"
                                               Text="{DynamicResource Settings.Triggers.PairDescription}" />

                                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                                    <TextBlock Text="{DynamicResource Settings.Triggers.MultiTitle}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                               Text="{DynamicResource Settings.Triggers.MultiDescription}" />

                                    <Border Style="{StaticResource Divider}" Margin="0,14" />

                                    <TextBlock Text="{DynamicResource Settings.Triggers.RealtimeTitle}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                                               Text="{DynamicResource Settings.Triggers.RealtimeDescription}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card.Subtle}" Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Text="{DynamicResource Settings.Triggers.NoModifierNote}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 语言 ===== -->
                <TabItem Header="{DynamicResource Settings.Tab.Language}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,2,12,16">
                            <TextBlock Text="{DynamicResource Settings.Language.Title}" Style="{StaticResource Text.Display}" />
                            <TextBlock Text="{DynamicResource Settings.Language.Description}"
                                       Style="{StaticResource Text.Caption}"
                                       Margin="0,4,0,18" />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <RadioButton Style="{StaticResource Radio.Option}"
                                                 GroupName="Language"
                                                 IsChecked="{Binding LanguageChinese, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings.Language.ChineseTitle}" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="{DynamicResource Settings.Language.ChineseDescription}"
                                                       Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </RadioButton>

                                    <Border Style="{StaticResource Divider}" Margin="0,12" />

                                    <RadioButton Style="{StaticResource Radio.Option}"
                                                 GroupName="Language"
                                                 IsChecked="{Binding LanguageEnglish, Mode=TwoWay}">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource Settings.Language.EnglishTitle}" Style="{StaticResource SettingTitle}" />
                                            <TextBlock Text="{DynamicResource Settings.Language.EnglishDescription}"
                                                       Style="{StaticResource Text.Caption}" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card.Subtle}" Margin="0,14,0,0">
                                <TextBlock Style="{StaticResource Text.Caption}"
                                           Text="{DynamicResource Settings.Language.Note}" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ===== 关于与许可 ===== -->
                <TabItem Header="{DynamicResource Settings.Tab.About}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,2,12,16">
                            <TextBlock Text="{DynamicResource Settings.About.Title}" Style="{StaticResource Text.Display}" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,18">
                                <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource Brush.BrandSoft}">
                                    <Viewbox Margin="9">
                                        <Canvas Width="32" Height="32">
                                            <Path Data="M6,22 C6,14.6 10.5,9.6 16,9.6 C21.5,9.6 26,14.6 26,22"
                                                  Stroke="{DynamicResource Brush.Brand}"
                                                  StrokeThickness="2.8"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round" />
                                            <Ellipse Canvas.Left="13.2" Canvas.Top="17" Width="5.6" Height="5.6" Fill="{DynamicResource Brush.Brand}" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ProductName}" Style="{StaticResource Text.Section}" />
                                    <TextBlock Text="{Binding VersionDisplay}" Style="{StaticResource Text.Caption}" />
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.About.PrivacyTitle}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Style="{StaticResource Text.Caption}"
                                               Margin="0,6,0,0"
                                               Text="{DynamicResource Settings.About.PrivacyDescription}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.About.AuthorTitle}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,8,0,0">
                                        <Run Text="{DynamicResource Settings.About.AuthorLabel}" />
                                        <Hyperlink NavigateUri="https://github.com/WuYu-Cjx"
                                                   Foreground="{DynamicResource Brush.Brand}"
                                                   TextDecorations="Underline"
                                                   RequestNavigate="OnHyperlinkRequestNavigate">Wu Yu</Hyperlink>
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,4,0,0">
                                        <Run Text="{DynamicResource Settings.About.ProjectLabel}" />
                                        <Hyperlink NavigateUri="https://github.com/WuYu-Cjx/KeyNest"
                                                   Foreground="{DynamicResource Brush.Brand}"
                                                   TextDecorations="Underline"
                                                   RequestNavigate="OnHyperlinkRequestNavigate">https://github.com/WuYu-Cjx/KeyNest</Hyperlink>
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Settings.About.LicensesTitle}" Style="{StaticResource SettingTitle}" />
                                        <Button Grid.Column="1"
                                                Content="{DynamicResource Settings.About.OpenLicenseList}"
                                                Style="{StaticResource Btn.Ghost}"
                                                Padding="10,4"
                                                Command="{Binding OpenLicenseCommand}" />
                                    </Grid>
                                    <ScrollViewer MaxHeight="150" Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                        <TextBlock Text="{Binding LicenseSummary}"
                                                   Style="{StaticResource Text.Caption}"
                                                   LineHeight="19" />
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{DynamicResource Settings.About.DataTitle}" Style="{StaticResource SettingTitle}" />
                                    <TextBlock Text="{Binding DataFolderPath}"
                                               Style="{StaticResource Text.Caption}"
                                               Margin="0,6,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="{DynamicResource Settings.About.OpenDataFolder}"
                                                Style="{StaticResource Btn.Secondary}"
                                                Command="{Binding OpenDataFolderCommand}" />
                                        <Button Content="{DynamicResource Settings.About.Uninstall}"
                                                Style="{StaticResource Btn.Danger}"
                                                Margin="10,0,0,0"
                                                Command="{Binding UninstallCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

            </TabControl>
        </Grid>
    </Border>
</Window>
